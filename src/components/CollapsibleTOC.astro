---
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import tocOptions from 'virtual:starlight-progress/toc-options';

const { toc } = (Astro.locals as { starlightRoute: StarlightRouteData }).starlightRoute;
---

{
	toc && (
		<details
			id="starlight-toc-collapsible"
			class="collapsible-toc"
			data-storage-key={tocOptions.storageKey}
			open={!tocOptions.defaultCollapsed}
		>
			<summary class="collapsible-toc__toggle" aria-label="Toggle table of contents">
				<span class="collapsible-toc__label">On this page</span>
				<svg
					class="collapsible-toc__chevron"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<polyline points="6 9 12 15 18 9" />
				</svg>
			</summary>
			<div class="collapsible-toc__content" id="starlight-toc-content">
				<TableOfContents />
			</div>
		</details>
	)
}

<style is:inline>
  #starlight-toc-collapsible .collapsible-toc__content h2 {
    display: none;
  }
</style>

<script is:inline>
  function initCollapsibleTOC() {
    var details = document.getElementById('starlight-toc-collapsible');
    if (!details) return;

    var storageKey = details.dataset.storageKey || 'starlight-toc-visible';
    var stored = localStorage.getItem(storageKey);
    if (stored !== null) {
      try {
        details.open = JSON.parse(stored);
      } catch {
        /* Ignore malformed stored values. */
      }
    }

    var observer = new MutationObserver(function () {
      localStorage.setItem(storageKey, JSON.stringify(details.open));
    });
    observer.observe(details, { attributes: true, attributeFilter: ['open'] });

    details.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        details.open = !details.open;
      }
    });
  }

  initCollapsibleTOC();

  document.addEventListener('astro:page-load', function () {
    initCollapsibleTOC();
  });
</script>
